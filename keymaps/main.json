{
  // A genuine keystroke divergence rather than a cmd/ctrl swap, and one block
  // per selector because a comma list is scored on its first branch alone.
  // :not([mini]) because it rewraps the file.
  ".platform-darwin lumine-text-editor:not([mini])": {
    "alt-cmd-q": "autoflow:reflow-selection"
  },
  ".platform-win32 lumine-text-editor:not([mini])": {
    "ctrl-shift-q": "autoflow:reflow-selection"
  },
  ".platform-linux lumine-text-editor:not([mini])": {
    "ctrl-shift-q": "autoflow:reflow-selection"
  }
}
