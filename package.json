{
  "name": "autoflow",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Reflow the current selection so that no line is longer than the preferred line length.",
  "keywords": [
    "reflow",
    "word-wrap",
    "reformat",
    "paragraph",
    "line-length"
  ],
  "repository": "https://github.com/lumine-code/autoflow",
  "bugs": {
    "url": "https://github.com/lumine-code/autoflow/issues"
  },
  "license": "MIT",
  "main": "./lib/autoflow",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "backgroundTips": [
    "You can reflow the selected text to your preferred line length with {{ 'autoflow:reflow-selection' | keystroke }}"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationCommands": {
    "lumine-text-editor": [
      "autoflow:reflow-selection"
    ]
  },
  "dependencies": {
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#9b0c8a6bc845c5ecd594d673ab97f4ddbe9e546f"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
